generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model User {
  id                           String         @id @default(uuid())
  email                        String         @unique
  passwordHash                 String
  name                         String?
  isActive                     Boolean        @default(true)
  emailVerified                Boolean        @default(false)
  emailVerificationToken       String?        @unique
  emailVerificationExpiresAt   DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  refreshTokens                RefreshToken[]

  @@index([emailVerificationToken])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

// ─── Indicators ───────────────────────────────────────────────────────────────

model Indicator {
  id             String              @id @default(uuid())
  name           String
  description    String?
  category       IndicatorCategory
  formula        String?
  unit           String?
  goalValue      Decimal?  @db.Decimal(18, 2)
  currentValue   Decimal?  @db.Decimal(18, 2)
  previousValue  Decimal?  @db.Decimal(18, 2)
  previousPeriod IndicatorPeriod?
  variation      Decimal?  @db.Decimal(10, 4)
  status         IndicatorStatus     @default(NEUTRAL)
  color          String?
  icon           String?
  chartType      IndicatorChartType  @default(NUMBER)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean             @default(true)
  showOnDashboard Boolean            @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category])
  @@index([status])
  @@index([isActive])
  @@index([showOnDashboard])
  @@index([createdAt])
}

enum IndicatorCategory {
  FINANCIAL
  COMMERCIAL
  OPERATIONAL
  MARKETING
  CUSTOMER
  CUSTOM
}

enum IndicatorChartType {
  LINE
  BAR
  AREA
  DONUT
  PIE
  GAUGE
  NUMBER
}

enum IndicatorStatus {
  SUCCESS
  WARNING
  DANGER
  NEUTRAL
}

enum IndicatorPeriod {
  PREVIOUS_MONTH
  PREVIOUS_QUARTER
  PREVIOUS_SEMESTER
  PREVIOUS_YEAR
  CUSTOM
}

// ─── Analysis ─────────────────────────────────────────────────────────────────

model Analysis {
  id          String            @id @default(uuid())
  name        String
  description String?
  chartType   AnalysisChartType
  category    AnalysisCategory
  dataset     String?
  metric      String?
  aggregation AnalysisAggregation
  groupBy     String?
  dateField   String?
  startDate   DateTime?
  endDate     DateTime?
  filters     Json?
  isFavorite  Boolean           @default(false)
  isPublic    Boolean           @default(false)
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category])
  @@index([chartType])
  @@index([isFavorite])
  @@index([isPublic])
  @@index([createdBy])
  @@index([createdAt])
}

enum AnalysisChartType {
  LINE
  BAR
  AREA
  PIE
  DONUT
  TABLE
  KPI
}

enum AnalysisAggregation {
  SUM
  COUNT
  AVG
  MAX
  MIN
  DISTINCT
}

enum AnalysisCategory {
  FINANCIAL
  COMMERCIAL
  CUSTOMER
  MARKETING
  OPERATIONAL
  CUSTOM
}
