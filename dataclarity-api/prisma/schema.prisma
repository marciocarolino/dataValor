generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model User {
  id                           String         @id @default(uuid())
  email                        String         @unique
  passwordHash                 String
  name                         String?
  isActive                     Boolean        @default(true)
  emailVerified                Boolean        @default(false)
  emailVerificationToken       String?        @unique
  emailVerificationExpiresAt   DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  refreshTokens                RefreshToken[]

  @@index([emailVerificationToken])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

// ─── Indicators ───────────────────────────────────────────────────────────────

model Indicator {
  id               String                    @id @default(uuid())
  name             String
  description      String?
  category         IndicatorCategory
  formula          String?
  unit             String?
  goalValue        Decimal?                  @db.Decimal(18, 2)
  minimumGoalValue Decimal?                  @db.Decimal(18, 2)
  maximumGoalValue Decimal?                  @db.Decimal(18, 2)
  desiredDirection IndicatorDesiredDirection @default(HIGHER_IS_BETTER)
  // ── Periodicidade de Apuração: frequência com que o indicador gera um novo
  // resultado (não confundir com previousPeriod, que é o Período de Referência) ─
  frequency        IndicatorFrequency        @default(MONTHLY)
  // ── Método de Apuração: como o resultado do período é calculado ─────────
  // SUM/AVG/MIN/MAX/LAST/COUNT = calculado das medições do período
  // FORMULA = calculado pelo futuro Formula Engine usando o campo `formula`
  // A fórmula é dado declarativo — nunca é executada diretamente
  aggregationType  AggregationType           @default(SUM)
  // ── Cache fields (fonte de verdade: IndicatorMeasurement) ───────────────
  currentValue     Decimal?                  @db.Decimal(18, 2)
  previousValue    Decimal?                  @db.Decimal(18, 2)
  previousPeriod   IndicatorPeriod?
  variation        Decimal?                  @db.Decimal(10, 4)
  status           IndicatorStatus           @default(NEUTRAL)
  // ── Visual ──────────────────────────────────────────────────────────────
  color            String?
  icon             String?
  chartType        IndicatorChartType        @default(NUMBER)
  // ── Prazo ───────────────────────────────────────────────────────────────
  startDate        DateTime?
  endDate          DateTime?
  daysRemaining    Int?
  // ── Dashboard slot (mapeamento aos 4 cards: REVENUE, PROFIT, CUSTOMERS, GROWTH) ─
  dashboardSlot    String?                   // null = não exibir em slot fixo; "REVENUE", "PROFIT", "CUSTOMERS", "GROWTH"
  // ── Controle ────────────────────────────────────────────────────────────
  isActive         Boolean                   @default(true)
  showOnDashboard  Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  measurements IndicatorMeasurement[]
  history      IndicatorHistory[]

  @@index([category])
  @@index([status])
  @@index([isActive])
  @@index([showOnDashboard])
  @@index([createdAt])
}

model IndicatorMeasurement {
  id            String    @id @default(uuid())
  indicatorId   String
  value         Decimal   @db.Decimal(18, 2)
  referenceDate DateTime
  periodStart   DateTime?
  periodEnd     DateTime?
  source        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, referenceDate])
  @@index([indicatorId, referenceDate])
  @@index([referenceDate])
}

enum IndicatorCategory {
  FINANCIAL
  COMMERCIAL
  OPERATIONAL
  MARKETING
  CUSTOMER
  CUSTOM
}

enum IndicatorChartType {
  LINE
  BAR
  AREA
  DONUT
  PIE
  GAUGE
  NUMBER
}

enum IndicatorStatus {
  SUCCESS
  WARNING
  DANGER
  NEUTRAL
}

enum IndicatorPeriod {
  PREVIOUS_MONTH
  PREVIOUS_QUARTER
  PREVIOUS_SEMESTER
  PREVIOUS_YEAR
  CUSTOM
}

model IndicatorHistory {
  id              String          @id @default(uuid())
  indicatorId     String
  // Janela temporal do resultado consolidado (ex: 2026-08-01 → 2026-08-31)
  periodStart     DateTime
  periodEnd       DateTime
  // Resultado do período
  value           Decimal?        @db.Decimal(18, 2)
  goalValue       Decimal?        @db.Decimal(18, 2)
  previousValue   Decimal?        @db.Decimal(18, 2)
  variationPercent Decimal?       @db.Decimal(10, 4)
  status          IndicatorStatus @default(NEUTRAL)
  notes           String?
  calculatedAt    DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, periodStart, periodEnd])
  @@index([indicatorId])
  @@index([periodStart])
  @@index([indicatorId, periodStart(sort: Desc)])
}

// Método de Apuração — define COMO o resultado de um período é calculado
enum AggregationType {
  SUM
  AVG
  MIN
  MAX
  LAST
  COUNT
  FORMULA
}

// Periodicidade de Apuração — frequência com que o indicador gera um novo resultado
enum IndicatorFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMESTERLY
  YEARLY
  CUSTOM
}

enum IndicatorDesiredDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  RANGE_IS_BETTER
}

// ─── Analysis ─────────────────────────────────────────────────────────────────

model Analysis {
  id          String              @id @default(uuid())
  name        String
  description String?
  chartType   AnalysisChartType
  category    AnalysisCategory
  dataset     String?
  metric      String?
  aggregation AnalysisAggregation
  groupBy     String?
  dateField   String?
  startDate   DateTime?
  endDate     DateTime?
  filters     Json?
  isFavorite  Boolean             @default(false)
  isPublic    Boolean             @default(false)
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category])
  @@index([chartType])
  @@index([isFavorite])
  @@index([isPublic])
  @@index([createdBy])
  @@index([createdAt])
}

enum AnalysisChartType {
  LINE
  BAR
  AREA
  PIE
  DONUT
  TABLE
  KPI
}

enum AnalysisAggregation {
  SUM
  COUNT
  AVG
  MAX
  MIN
  DISTINCT
}

enum AnalysisCategory {
  FINANCIAL
  COMMERCIAL
  CUSTOMER
  MARKETING
  OPERATIONAL
  CUSTOM
}
