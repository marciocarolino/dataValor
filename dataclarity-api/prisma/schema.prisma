generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model User {
  id                           String         @id @default(uuid())
  email                        String         @unique
  passwordHash                 String
  name                         String?
  isActive                     Boolean        @default(true)
  emailVerified                Boolean        @default(false)
  emailVerificationToken       String?        @unique
  emailVerificationExpiresAt   DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt
  refreshTokens                RefreshToken[]

  @@index([emailVerificationToken])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

// ─── Indicators ───────────────────────────────────────────────────────────────

model Indicator {
  id             String              @id @default(uuid())
  name           String
  description    String?
  category       IndicatorCategory
  formula        String?
  unit           String?
  goalValue      Float?
  currentValue   Float?
  previousValue  Float?
  variation      Float?
  status         IndicatorStatus     @default(NEUTRAL)
  color          String?
  icon           String?
  chartType      IndicatorChartType  @default(NUMBER)
  isActive       Boolean             @default(true)
  showOnDashboard Boolean            @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([category])
  @@index([status])
  @@index([isActive])
  @@index([showOnDashboard])
  @@index([createdAt])
}

enum IndicatorCategory {
  FINANCIAL
  COMMERCIAL
  OPERATIONAL
  MARKETING
  CUSTOMER
  CUSTOM
}

enum IndicatorChartType {
  LINE
  BAR
  AREA
  DONUT
  PIE
  GAUGE
  NUMBER
}

enum IndicatorStatus {
  SUCCESS
  WARNING
  DANGER
  NEUTRAL
}
