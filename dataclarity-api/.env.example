NODE_ENV=development
PORT=3001
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4200
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP — e-mail transacional
# Desenvolvimento: use Ethereal (https://ethereal.email) ou Mailtrap
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DataClarity <noreply@dataclarity.com.br>

# Docker (PostgreSQL)
POSTGRES_DB=dataclarity
POSTGRES_USER=dataclarity
POSTGRES_PASSWORD=dataclarity
POSTGRES_PORT=5432

# Docker (Redis)
REDIS_PORT=6379
